# Studio Hub — local demo
# Copy to .env.local and fill in only what you have.

# AI (Gemini is the default writer / extractor / transcriber)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional comma-separated fallbacks if a model is retired or busy
GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.1-flash-lite

# Optional OpenAI-compatible fallback (DeepSeek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional live web research for Market Pulse
SEARCH_API_KEY=

# Optional email delivery
RESEND_API_KEY=

# Public URL used when building OAuth callbacks and approval links.
# Meta requires HTTPS, so use a tunnel (ngrok/cloudflared) or your deployed URL.
APP_URL=http://localhost:3000

# Unified publishing (optional; carries the platform approvals)
# Free plan: 10 uploads/month, 2 profiles, no TikTok.
UPLOADPOST_API_KEY=
UPLOADPOST_PLAN=free
UPLOADPOST_FREE_LIMIT=10
UPLOADPOST_API_BASE=https://api.upload-post.com

# Platform apps — not required for the local assisted-mode demo
META_APP_ID=
META_APP_SECRET=
# Optional: Facebook Login for Business configuration ID (replaces the raw scope list)
META_LOGIN_CONFIG_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# WhatsApp Cloud API (optional inbound voice notes)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Cloudflare R2 (multipart uploads; leave blank to use the local chunked fallback)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket base URL for previews, e.g. https://media.yourdomain.com
R2_PUBLIC_BASE_URL=

# Production TLS domain used by Caddy (docker compose)
DOMAIN=

# Shown on privacy/terms/data-deletion pages
SUPPORT_EMAIL=

# Encrypt OAuth tokens before storing them (generate a long random value)
APP_ENCRYPTION_KEY=
