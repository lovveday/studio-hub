# Studio Hub — local demo
# Copy to .env.local and fill in only what you have.

# AI (Gemini is the default writer / extractor / transcriber)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI-compatible fallback (DeepSeek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional live web research for Market Pulse
SEARCH_API_KEY=

# Optional email delivery
RESEND_API_KEY=

# Public URL used when building OAuth callbacks and approval links.
# Meta requires HTTPS, so use a tunnel (ngrok/cloudflared) or your deployed URL.
APP_URL=http://localhost:3000

# Platform apps — not required for the local assisted-mode demo
META_APP_ID=
META_APP_SECRET=
# Optional: Facebook Login for Business configuration ID (replaces the raw scope list)
META_LOGIN_CONFIG_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# WhatsApp Cloud API (optional inbound voice notes)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Object storage (optional; local storage is used without it)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Encrypt OAuth tokens before storing them (generate a long random value)
APP_ENCRYPTION_KEY=
